            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Kiran Das\",\n  \"email\": \"kiran@example.com\",\n  \"roleId\": 3,\n  \"status\": \"Active\",\n  \"password\": \"Password@123\"\n}"
            }
          }
        },
        {
          "name": "Edit user",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/2",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "2"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Bob Williams\",\n  \"email\": \"bob@example.com\",\n  \"roleId\": 3,\n  \"status\": \"Active\"\n}"
            }
          }
        },
        {
          "name": "Delete user",
          "request": {
            "method": "DELETE",
