{
  "info": {
    "name": "EDABIP - Users API (Dheepanraj)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the app (mvn spring-boot:run) then run this collection top to bottom. Add User stores the generated id in {{userId}}."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1/users"
    },
    {
      "key": "userId",
      "value": "USR001"
    }
  ],
  "item": [
    {
      "name": "1. Happy path",
      "item": [
        {
          "name": "List users (page 1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}?page=1&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                ""
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            },
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('Consistent JSON envelope', function () { const j = pm.response.json(); pm.expect(j).to.have.property('success'); pm.expect(j).to.have.property('message'); pm.expect(j).to.have.property('timestamp'); });",
                  "pm.test('Has pagination', function(){ const d=pm.response.json().data; pm.expect(d).to.have.property('totalElements'); pm.expect(d.content).to.be.an('array'); });"
                ]
              }
            }
          ]
        },
